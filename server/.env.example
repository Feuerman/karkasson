# Конфигурация Firebase Realtime Database для production-сервера.
# Скопируй файл в server/.env, заполни значения и не коммить его.
# Локальный запуск: node --env-file=server/.env server/dist/index.js
# Файл обязателен только при NODE_ENV=production: в разработке и тестах
# сервер работает с in-memory хранилищем и Firebase не нужен.

# Обязательные
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=
# Origin клиента через запятую. Если не задан, в production используется
# https://feuerman.github.io
CLIENT_ORIGIN=
# Секрет подписи сессий: не короче 32 символов
SESSION_SECRET=

# Необязательные
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Доверять X-Forwarded-For и X-Forwarded-Proto за обратным прокси (например,
# Render). Включать только когда сервер действительно стоит за прокси.
TRUST_PROXY=false

# Токен защищённого endpoint /health/details. Если пусто, endpoint отвечает 404.
HEALTH_TOKEN=

# Socket.IO Admin UI в production выключен; включение требует явного согласия
# и настроенной пары логин/хеш пароля.
SOCKET_ADMIN_UI_ENABLED=false
SOCKET_ADMIN_UI_USERNAME=
SOCKET_ADMIN_UI_PASSWORD_HASH=
SOCKET_ADMIN_UI_READONLY=true
