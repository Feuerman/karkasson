{
  "name": "karkasson",
  "description": "Онлайн-игра «Каркассон»: Vue 3 клиент и игровой сервер на Node.js/Socket.IO",
  "version": "2.22.0",
  "private": true,
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.integration.config.ts --coverage.enabled",
    "test:gameplay": "vitest run --config vitest.integration.config.ts tests/integration/computerOnly.test.ts tests/integration/scoring.test.ts",
    "test:browser": "pnpm --filter server run build && playwright test",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "pnpm run format && pnpm run type-check && pnpm test && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "socket.io-client": "^4.7.2",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-vue": "^9.19.2",
    "happy-dom": "^21.0.1",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
