#!/usr/bin/env sh
# Pre-commit hook: автоматически форматирует индексированные файлы Prettier.
# Активация: git config core.hooksPath .githooks
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|mts|ctm|vue|json)$' || true)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    pnpm exec prettier --write "$file" >/dev/null 2>&1
    git add "$file"
  done
fi
