# Клиентская конфигурация Firebase Auth (вход через Google).
# Скопируй в .env.local, заполни значения из Firebase Console → Project settings
# → General → Your apps → SDK setup and configuration (объект firebaseConfig).
# Не коммить реальные значения в репозиторий.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Адрес сервера (локальная разработка).
VITE_SERVER_URL=http://localhost:3001
